<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme._2048Original" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background -->
        <item name="windowSplashScreenBackground">#1A0E45</item>
        <!-- Set the splash screen icon -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_fg_sprites</item>
        <item name="windowSplashScreenIconBackgroundColor">#2B1870</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <!-- Post splash screen theme -->
        <item name="postSplashScreenTheme">@style/Theme._2048Original</item>
    </style>
</resources>